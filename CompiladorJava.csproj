<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CompiladorJava</RootNamespace>
    <AssemblyName>CompiladorJava</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <StartupObject>CompiladorJava.Frontend.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Frontend\Ejemplos\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
